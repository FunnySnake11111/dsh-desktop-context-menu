{
  "name": "dsh-desktop-context-menu",
  "version": "0.1.2",
  "description": "DeepSeek Harness Desktop 专属右键实用工具菜单：编辑、网页/Agent 搜索、Agent 快捷动作、文本工具、翻译与站内搜索、复制整条消息、导出对话（Markdown/JSON/PDF）。纯客户端 DOM 实现，并内嵌 host-patch（导航策略 + 剪贴板权限）宿主自愈，随应用更新不丢失。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/host-patch.mjs",
    "lib/index.js",
    "lib/patches",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-menu",
    "right-click",
    "utility"
  ],
  "author": "FunnySnake11111",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FunnySnake11111/dsh-desktop-context-menu.git"
  },
  "homepage": "https://github.com/FunnySnake11111/dsh-desktop-context-menu#readme",
  "bugs": {
    "url": "https://github.com/FunnySnake11111/dsh-desktop-context-menu/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
